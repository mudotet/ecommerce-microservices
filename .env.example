# Docker Compose reads .env from the repository root.
# Product and Order read these variables from their process environment.
POSTGRES_USER=admin
POSTGRES_PASSWORD=replace-with-your-local-password

# Initial Keycloak administrator for local development.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-your-local-keycloak-password

# Auth Service: copy the backend client's secret from the Keycloak console.
KEYCLOAK_CREDENTIALS_SECRET=replace-with-your-local-client-secret
